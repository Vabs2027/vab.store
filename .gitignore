# ===== PYTHON И DJANGO =====
# Не загружаем виртуальное окружение и временные файлы Python
venv/
__pycache__/
*.py[cod]

# ===== БАЗА ДАННЫХ =====
# Локальную базу данных SQLite не публикуем
*.sqlite3

# ===== СЕКРЕТНЫЕ ДАННЫЕ =====
# Не загружаем файлы с паролями и секретными настройками
.env
.env.*
!.env.example

# ===== МЕДИАФАЙЛЫ =====
# Пока не загружаем изображения и файлы, добавленные через сайт
store/media/

# ===== REACT =====
# Зависимости и результаты сборки можно восстановить
store-frontend/node_modules/
store-frontend/build/
store-frontend/dist/

# Готовая сборка React, находящаяся внутри Django
store/build/

# Не публикуем локальные настройки React
store-frontend/.env
store-frontend/.env.*

# ===== РЕДАКТОРЫ КОДА =====
# Не загружаем личные настройки редакторов
.idea/
.vscode/

# ===== СИСТЕМНЫЕ ФАЙЛЫ =====
# Не загружаем служебные файлы операционной системы
.DS_Store
Thumbs.db